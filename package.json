{
  "name": "pptx-glimpse",
  "version": "1.0.1",
  "description": "Local PPTX to SVG/PNG converter with animation step support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint src/ scripts/",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write 'src/**/*.ts' 'scripts/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'scripts/**/*.ts'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "dev": "tsx scripts/dev-server.ts",
    "render": "tsx scripts/test-render.ts",
    "render:samples": "tsx scripts/render-samples.ts",
    "render:check": "tsx scripts/check-samples.ts check",
    "baseline:update": "tsx scripts/check-samples.ts update",
    "inspect": "tsx scripts/inspect-pptx.ts"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2",
    "fast-xml-parser": "^5.7.3",
    "fflate": "^0.8.2",
    "opentype.js": "1.3.4"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jszip": "^3.10.1",
    "knip": "^5.85.0",
    "pixelmatch": "^7.1.0",
    "prettier": "^3.0.0",
    "sharp": "^0.34.5",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.1.0",
    "ws": "^8.19.0"
  }
}
